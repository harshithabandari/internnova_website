{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start static server",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "http.server",
                "8080",
                "--bind",
                "127.0.0.1"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": ".*",
                    "message": 0
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Serving HTTP on 127\\.0\\.0\\.1 port 8080"
                }
            }
        }
    ]
}